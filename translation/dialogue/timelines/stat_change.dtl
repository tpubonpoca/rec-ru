label CHARISMA #id:554
[sound path="res://audio/se/Powerup_XP.wav" volume="-6.0" bus="Cutscene"]
[color=ff934d]Получено {GameVariables.get_xp_gain()} опыта Харизмы![/color] #id:1002
if {GameVariables.get_xp_gain()} >= {GameVariables.get_charisma_required_xp()}:
	[sound path="res://audio/se/Powerup_LVL.wav" volume="-6.0" bus="Cutscene"]
	Харизма повышена! #id:556
	Теперь ты [color=ff934d]{GameVariables.get_charisma_description(GameVariables.get_base_charisma() + 1)}[/color]. #id:b9e
set GameVariables.charisma_total_xp += {GameVariables.get_xp_gain()}
return
