label ADVENTURE_MUSIC #id:b78
if {BattleVariables.is_night_run()} == true or {BattleVariables.level} == 4 or {BattleVariables.alternate} == true:
	audio music4 "res://audio/bgm/Mesmerizing Galaxy Loop.mp3" [fade="1.0" volume="-18.0" bus="Music"]
else:
	audio music4 "res://audio/bgm/Voxel Revolution.mp3" [fade="1.0" volume="-18.0" bus="Music"]
return
