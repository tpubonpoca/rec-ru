label ADVENTURE_MUSIC #id:b78
if {BattleVariables.is_night_run()} == true or {BattleVariables.level} == 4:
	[music path="res://audio/bgm/Mesmerizing Galaxy Loop.mp3" bus="Music" channel="3" fade="1.0" volume="-18.0"]
else:
	[music path="res://audio/bgm/Voxel Revolution.mp3" bus="Music" channel="3" fade="1.0" volume="-18.0"]
return
