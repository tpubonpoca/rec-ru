label START #id:6b
[signal arg="load_random_enemy"]
label START_SKIP_LOAD_ENEMY
jump adventure_functions/LOAD_ENEMY
[signal arg="battle_style"]
if {GameVariables.yuna_partnered}:
	update roommate [extra_data="set Expressions/Happy"]
	roommate: <Надери им задницы!/Покажи им, кто тут главный!/Ты справишься!> #id:bc4
label PLAYER_TURN #id:6e
jump adventure_functions/CHECK_PLAYER_DEFEAT
if {GameVariables.yuna_partnered}:
	jump adventure_functions/YUNA_TURN
if {GameVariables.yosuke_partnered}:
	jump adventure_functions/YOSUKE_TURN
jump adventure_functions/PLAYER_DEBUFF_TICKS
label PLAYER_OPTIONS #id:7a
[signal arg="battle_style"]
- Attack #id:7b
	if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "attack":
		Эта способность сейчас заблокирована!
		jump PLAYER_OPTIONS
	if {BattleVariables.player_is_confused}:
		jump adventure_functions/RANDOM_ABILITY
	else:
		jump adventure_functions/DISPLAY_TARGETS
	label ATTACK
	if {BattleVariables.is_mad()}:
		[sound bus="Cutscene" path="res://audio/battle/SkillWhispers.ogg" volume="3.0"]
		[signal arg="vision_red"]
		Голоса что-то шепчут тебе. #id:7c
		Ты вдруг забываешь, что собирался сделать. #id:7d
		jump ENEMY_TURN
	if {BattleVariables.player_is_charmed} && {BattleVariables.is_successful_attack_through_charm()} == false:
		[sound bus="Cutscene" path="res://audio/battle/AttackMiss.wav" volume="0.0"]
		Ты очарован! #id:bc5
		jump ENEMY_TURN
	[sound bus="Cutscene" path="res://audio/battle/AttackAttempt.wav" volume="0.0"]
	Ты бросаешься на [color=ff3f49]{BattleVariables.get_target_name()}[/color]! #id:1014
	[signal arg="enemy_dodge"]
	[wait time="0.3"]
	if {BattleVariables.is_successful_hit("player")}:
		[signal arg="shake"]
		[signal arg="enemy_shake"]
		jump sounds/BATTLE_ATTACK_HIT
		Попадание! [color=ff3f49]{BattleVariables.get_target_name()}[/color] получает [color=ff3f49]{BattleVariables.take_damage_player()}[/color] урона! #id:1015
		if {BattleVariables.get_target().WeakenedByHitting} && {BattleVariables.get_target().IsWeakened} == false:
			set BattleVariables.target_enemy.IsWeakened = true
			[signal arg="show_weakness"]
			jump sounds/GLASS
			{BattleVariables.get_target().GetWeakenedLine()} #id:1016
	else:
		[sound bus="Cutscene" path="res://audio/battle/AttackMiss.wav" volume="0.0"]
		[color=ff3f49]{BattleVariables.get_target_name()}[/color] уворачивается от твоей атаки! #id:1017
	jump adventure_functions/CHECK_ENEMY_DEFEAT
	jump ENEMY_TURN
- Defend #id:83
	if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "defend":
		Эта способность сейчас заблокирована!
		jump PLAYER_OPTIONS
	if {BattleVariables.player_is_confused}:
		jump adventure_functions/RANDOM_ABILITY
	label DEFEND
	if {GameVariables.stamina} <= 5:
		Не хватает выносливости, чтобы защищаться. #id:bca
		jump PLAYER_OPTIONS
	set BattleVariables.player_is_defending = true
	set GameVariables.stamina = {GameVariables.change_stamina(-5)}
	Ты поднимаешь руки, прикрываясь. #id:84
	jump ENEMY_TURN
- Talk #id:85
	if {BattleVariables.is_mad()}:
		[sound bus="Cutscene" path="res://audio/battle/SkillWhispers.ogg" volume="3.0"]
		[signal arg="vision_red"]
		Голоса что-то шепчут тебе. #id:86
		Ты вдруг забываешь, что собирался сделать. #id:87
		jump ENEMY_TURN
	- Charm #id:8d
		if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "charm":
			Эта способность сейчас заблокирована!
			jump PLAYER_OPTIONS
		if {BattleVariables.player_is_confused}:
			jump adventure_functions/RANDOM_ABILITY
		else:
			jump adventure_functions/DISPLAY_TARGETS
		label CHARM
		set BattleVariables.talk_type = "charm"
		[sound bus="Cutscene" path="res://audio/battle/TalkAttempt.wav" volume="0.0"]
		Ты осыпаешь комплиментами противника: [color=ff3f49]{BattleVariables.get_target_name()}[/color]! #id:1019
		protagonist: {BattleVariables.get_talk_player()}
		jump adventure_calculations/PLAYER_TALK
	- Enrage #id:92
		if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "enrage":
			Эта способность сейчас заблокирована!
			jump PLAYER_OPTIONS
		if {BattleVariables.player_is_confused}:
			jump adventure_functions/RANDOM_ABILITY
		else:
			jump adventure_functions/DISPLAY_TARGETS
		label ENRAGE
		set BattleVariables.talk_type = "enrage"
		[sound bus="Cutscene" path="res://audio/battle/TalkAttempt.wav" volume="0.0"]
		Ты оскорбляешь противника: [color=ff3f49]{BattleVariables.get_target_name()}[/color]! #id:101a
		protagonist: {BattleVariables.get_talk_player()}
		jump adventure_calculations/PLAYER_TALK
	- Fear #id:88
		if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "fear":
			Эта способность сейчас заблокирована!
			jump PLAYER_OPTIONS
		if {BattleVariables.player_is_confused}:
			jump adventure_functions/RANDOM_ABILITY
		else:
			jump adventure_functions/DISPLAY_TARGETS
		label FEAR
		set BattleVariables.talk_type = "fear"
		[sound bus="Cutscene" path="res://audio/battle/TalkAttempt.wav" volume="0.0"]
		Ты угрожаешь противнику: [color=ff3f49]{BattleVariables.get_target_name()}[/color]! #id:1018
		protagonist: {BattleVariables.get_talk_player()}
		jump adventure_calculations/PLAYER_TALK
	- Back #id:97
		jump PLAYER_OPTIONS
- Special #id:98
	if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "skills":
		Эта способность сейчас заблокирована!
		jump PLAYER_OPTIONS
	if {BattleVariables.player_is_enraged}:
		Ты в бешенстве!
		jump PLAYER_OPTIONS
	if {BattleVariables.player_skill_charge} >= 20:
		jump adventure_skills/PLAYER
	else:
		Не хватает заряда. Нужно [color=d3ff75]{int({BattleVariables.player_skill_charge})}/20[/color]. #id:bd1
		jump PLAYER_OPTIONS
- Run #id:9a
	if {BattleVariables.player_is_jammed} and {BattleVariables.player_jammed_ability} == "run":
		Эта способность сейчас заблокирована!
		jump PLAYER_OPTIONS
	if {BattleVariables.player_is_confused}:
		jump adventure_functions/RANDOM_ABILITY
	Ты пытаешься сбежать! #id:101b
	if {BattleVariables.is_successful_runaway()}:
		Удалось смыться! #id:101c
		leave boss
		leave enemy
		leave enemy_2
		jump adventure/LOOP_W_MUSIC
	else:
		Сбежать не вышло! #id:101d
		jump ENEMY_TURN
label ENEMY_TURN #id:9b
jump adventure_functions/ENEMY_DEBUFF_TICKS
if {BattleVariables.acting_enemy.CanUseSkill()}:
	jump adventure_skills/START
[signal arg="make_enemy_decision"]
if {BattleVariables.enemy_decision} == "talk":
	jump adventure_calculations/ENEMY_TALK
if {BattleVariables.enemy_decision} == "attack":
	if {BattleVariables.enemy_turn_index} == 0:
		enemy: {BattleVariables.pick_random_attack_line()}
	if {BattleVariables.enemy_turn_index} == 1:
		enemy_2: {BattleVariables.pick_random_attack_line()}
	jump adventure_calculations/ENEMY_DEFAULT_ATTACK
jump adventure_functions/END_ENEMY_TURN
