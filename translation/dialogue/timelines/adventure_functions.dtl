		set GameVariables.enemies_defeated += 1
		jump sounds/GOT_ITEM
		Ты также нашёл [color=e5be3e]{BattleVariables.get_item_reward(2)}[/color]! #id:109b
		if {BattleVariables.item_newly_found} && {BattleVariables.item_has_comment}:
			protagonist: На обороте есть описание... #id:109c
			protagonist: [color=e5be3e]«{BattleVariables.item_description}»[/color] #id:109d
		if {GameVariables.yuna_partnered} && {BattleVariables.has_item_reaction()}:
			update roommate [extra_data="set Expressions/Happy"]
			roommate: {BattleVariables.item_reward.YunaComment} #id:109e
if {BattleVariables.is_enemy_sexable()}:
	jump adventure_sex/START
jump adventure/LOOP
