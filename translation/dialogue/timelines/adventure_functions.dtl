label DISPLAY_TARGETS
if {BattleVariables.are_multiple_enemies_alive()} == false:
	set BattleVariables.target_index = {BattleVariables.auto_target_index()}
	return
[signal arg="default_style"]
if {BattleVariables.get_number_of_alive_enemies()} > 3:
	[signal arg="double_style"]
label TARGETS
- {BattleVariables.get_enemy_name(0)} | [if {BattleVariables.is_enemy_alive(0)}]
	[signal arg="battle_style"]
	set BattleVariables.target_index = 0
- {BattleVariables.get_enemy_name(1)} | [if {BattleVariables.is_enemy_alive(1)}]
	[signal arg="battle_style"]
	set BattleVariables.target_index = 1
- {BattleVariables.get_enemy_name(2)} | [if {BattleVariables.is_enemy_alive(2)}]
	[signal arg="battle_style"]
	set BattleVariables.target_index = 2
- {BattleVariables.get_enemy_name(3)} | [if {BattleVariables.is_enemy_alive(3)}]
	[signal arg="battle_style"]
	set BattleVariables.target_index = 3
- Отмена #id:107a
	jump adventure_battle/PLAYER_OPTIONS
return

label RANDOM_ABILITY
set BattleVariables.target_index = {BattleVariables.auto_target_index()}
[signal arg="make_confused_choice"]
if {BattleVariables.player_confused_decision} == "attack":
	jump adventure_battle/ATTACK
elif {BattleVariables.player_confused_decision} == "defend":
	jump adventure_battle/DEFEND
elif {BattleVariables.player_confused_decision} == "charm":
	jump adventure_battle/CHARM
elif {BattleVariables.player_confused_decision} == "enrage":
	jump adventure_battle/ENRAGE
elif {BattleVariables.player_confused_decision} == "fear":
	jump adventure_battle/FEAR
elif {BattleVariables.player_confused_decision} == "paparazzi":
	jump adventure_skills/PAPARAZZI

label END_ENEMY_TURN #id:107b
if {BattleVariables.enemy_turn_index} < {BattleVariables.enemies.size() - 1}:
	set BattleVariables.enemy_turn_index += 1
	jump adventure_battle/ENEMY_TURN
else:
	set BattleVariables.enemy_turn_index = 0
	jump adventure_battle/PLAYER_TURN
return

label GUARD_MESSAGE #id:c10
if {BattleVariables.player_is_defending}:
	[sound bus="Cutscene" path="res://audio/se/Guard.wav" volume="0.0"]
	Ты в защите! Все входящие эффекты ослаблены. #id:107c
return

