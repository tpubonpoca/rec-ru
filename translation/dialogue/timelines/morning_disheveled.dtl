jump sounds/INDOOR_APARTMENT_ENVIRONMENT
[background arg="res://assets/Cutscene/Backgrounds/Dorm_Room.png" fade="0.0"]
[wait time="0.6"]
if {GameVariables.is_shaved_recently}:
	set GameVariables.is_shaved_recently = false
	jump sounds/SURPRISE
	roommate: [font_size=24]ЧТО ЗА...[/font_size]
	roommate: [font_size=24]КТО МНЕ ПОБРИЛ ЛОБОК?![/font_size]
	[sound bus="Cutscene" path="res://audio/se/Steps_Approaching_Short.ogg" volume="-6.0"]
	[wait time="2.0"]
jump sounds/DOOR_KNOCK
protagonist: Да, входи. #id:41e
jump sounds/DOOR_OPEN
join roommate center
jump sounds/VOICE_UM
roommate: Привет... #id:41f
set GameVariables.disheveled_times += 1
if {GameVariables.disheveled_times} == 1:
	roommate: Можно спросить тебя кое о чём?
	protagonist: Ага, что такое? #id:421
	roommate: Ну... как бы это сказать...
	roommate: Моя одежда... я её вечно куда-то теряю...
	protagonist: (Блять.)
	roommate: Ты, случайно, не замечал ничего подозрительного... нет?
	roommate: Ну, например, чтобы Кан или ещё кто-то заходил ко мне в комнату?
	protagonist: Нет... ничего такого.
	update roommate [extra_data="set Expressions/Confused"]
	roommate: Хм-м...
	roommate: Ладно.
elif {GameVariables.disheveled_times} == 2:
	roommate: Опять то же самое.
	protagonist: Что опять?
	roommate: Мою одежду точно кто-то перекладывает...
	protagonist: (Блять.)
	protagonist: А с Каном ты не пробовала поговорить?
	roommate: Нет, пока нет.
	protagonist: Уверен, у него найдётся какое-нибудь разумное объяснение...
	protagonist: ...а иначе я вообще без понятия, что происходит.
	update roommate [extra_data="set Expressions/Confused"]
	roommate: Хм-м...
	roommate: Ладно.
else:
	update roommate [extra_data="set Expressions/Annoyed"]
	roommate: Я знаю, что это ты.
	roommate: Хватит лазить ко мне в комнату, извращенец.
leave roommate
jump sounds/DOOR_CLOSE
if {GameVariables.disheveled_times} == 1:
	set GameVariables.relationship_change = 2
elif {GameVariables.disheveled_times} == 2:
	set GameVariables.relationship_change = 5
else:
	set GameVariables.relationship_change = 10
jump stat_change/RELATIONSHIP_DECREASE
protagonist: (Надо быть аккуратнее, когда ночью лезу к Юне.)
protagonist: Если правильно надевать на неё одежду обратно, её [color=ff3f49]подозрение[/color] будет расти медленнее.
set GameVariables.disheveled = false
jump z_functions/END_TO_NEXT_CUTSCENE
