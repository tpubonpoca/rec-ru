Вечеринка продолжается... #id:8b5
if {GameVariables.party_stage} == 1:
	set {number} = {GameVariables.get_morning_event()}
	if {number} == 0:
		jump party_event_morning_pizza/
	elif {number} == 1:
		jump party_event_morning_alcohol/
	else:
		jump party_event_morning_shots/
elif {GameVariables.party_stage} == 2:
	set {number} = {GameVariables.get_afternoon_event()}
	if {number} == 0:
		jump party_event_afternoon_cop/
	elif {number} == 1:
		jump party_event_afternoon_punch/
	else:
		jump party_event_afternoon_twister/
else:
	if {Cutscenes.IsSceneSeen("yosuke_4")} and {Items.GetQuantity('laboratory_key')} < 1:
    jump party_event_evening_kan_room/
	set {number} = {GameVariables.get_evening_event()}
	if {number} == 0:
		jump party_event_evening_beer_pong/
	elif {number} == 1:
		jump party_event_evening_strip_games/
	else:
		jump party_event_evening_kan_room/
