label START #id:fb8
jump sounds/INDOOR_APARTMENT_NIGHT_ENVIRONMENT
jump sounds/MOVE_INDOORS
[background arg="res://assets/Cutscene/Backgrounds/Living_Room_Night.png" fade="0.6"]
if {Calendar.IsDayOff()}:
	protagonist: Хм...
	protagonist: ...никого нет.
	- К себе в комнату
		jump night/RETURN
Ты успеваешь застать соседку перед сном. #id:190
join roommate center
if {GameVariables.get_relationship()} >= 20 && {GameVariables.suspicion} < 50:
	roommate: Привет! Чего хотел? #id:197
else:
	roommate: Что такое? #id:198
label MAIN #id:88f
- Подарить подарок #id:d14
	jump GIVE_GIFT
- Отдать предмет #id:890
	jump GIVE_ITEM
- Отдать аксессуар #id:891
	jump ACCESSORY
- К себе в комнату #id:10da
	leave roommate
	jump night/RETURN
label GIVE_GIFT #id:d15
- Поболтать #id:d16
	protagonist: Как жизнь? Ничего интересного не случилось? #id:d17
	roommate: А? Ну... #id:d18
	if {GameVariables.is_relationship_locked()} && {GameVariables.get_relationship()} == 20:
		roommate: Я в последнее время слишком часто ем где попало... #id:d19
		protagonist: Да? #id:d1a
		roommate: Ага, хотелось бы по утрам иметь побольше времени на себя... #id:d1b
		roommate: ...но я вечно не могу вовремя проснуться. #id:d1c
		roommate: Особенно с этой учёбой... #id:d1d
		protagonist: (Хм... может, как-нибудь приготовить ей поесть...) #id:d1e
		jump GIVE_GIFT
	if {GameVariables.is_relationship_locked()} && {GameVariables.get_relationship()} == 40:
		roommate: Кажется, я в последнее время поправилась... #id:d1f
		protagonist: Да ну? По-моему, нет. #id:d20
		update roommate [extra_data="set Expressions/Happy"]
		roommate: Ой, перестань. Подлизываться бесполезно. #id:d21
		roommate: В общем, ага. Подумываю заняться бегом! #id:d22
		protagonist: Отличная идея! #id:d23
		roommate: Скажи? #id:d24
		update roommate [extra_data="set Expressions/Confused"]
		roommate: Только надо купить [color=e5be3e]кроссовки для бега[/color]... #id:d25
		jump GIVE_GIFT
	roommate: Да вроде ничего такого. #id:d26
	protagonist: Понятно... #id:d27
	jump GIVE_GIFT
- Подарить подарок | [if {Items.GetQuantity('gift')} > 0] #id:19a
	set GameVariables.quantity = {Items.Decrement('gift')}	
	set GameVariables.suspicion -= 5
	if {GameVariables.suspicion} < 0:
		set GameVariables.suspicion = 0
	roommate: ...что это? #id:19b
	roommate: Ты мне подарок купил? #id:19c
	if {GameVariables.get_relationship()} > 20:
		jump sounds/VOICE_THANK_YOU
		roommate: Спасибо. Мне приятно.
	else:
		roommate: Ну... спасибо, что ли.
	set GameVariables.relationship_change = 3
	jump stat_change/RELATIONSHIP_INCREASE
	if {GameVariables.is_relationship_locked()}:
		protagonist: (Такое чувство, что наши отношения упёрлись в потолок...) #id:d28
		protagonist: (Может, стоит с ней об этом поговорить?) #id:d29
	jump GIVE_GIFT
- Подарить кроссовки | [if {Items.GetQuantity('running_shoes')} > 0 && {Cutscenes.IsSceneLocked("event_relationship_40")}] #id:d2a
	jump POSSIBLE_SUSPICION
	set GameVariables.scene_unlocked = {Cutscenes.UnlockCutscene("event_relationship_40")}
	set GameVariables.quantity = {Items.Decrement('running_shoes')}
	roommate: Кроссовки для бега? #id:d2b
	jump sounds/VOICE_THANK_YOU
	update roommate [extra_data="set Expressions/Happy"]
	roommate: Спасибо! Они классные! #id:d2c
	roommate: Обязательно примерю при первой же возможности. #id:d2d
	update roommate [extra_data="set Decorations/Blush"]
	roommate: ...может, как-нибудь побегаем вместе? #id:d2e
	jump GIVE_GIFT
- Назад #id:d2f
	jump MAIN
label GIVE_ITEM #id:199
- Дать зелёный чай | [if {Items.GetQuantity('green_tea')} > 0 && {GameVariables.applied_green_tea} == false] #id:19f
	roommate: Попить? Мне? #id:1a0
	jump POSSIBLE_SUSPICION
	if {GameVariables.get_relationship()} >= 20:
		jump sounds/VOICE_THANK_YOU
		set GameVariables.quantity = {Items.Decrement('green_tea')}
		roommate: Спасибо! #id:1a1
		set GameVariables.applied_green_tea = true
		jump GIVE_ITEM
	else:
		roommate: Оставь себе, я не хочу пить. #id:1a2
		protagonist: (Похоже, мы ещё недостаточно близки для такого.) #id:1a3
		jump GIVE_ITEM
