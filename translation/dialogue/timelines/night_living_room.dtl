label START #id:fb8
jump sounds/INDOOR_APARTMENT_NIGHT_ENVIRONMENT
[sound bus="Cutscene" path="res://audio/se/Move1.ogg"]
[background arg="res://assets/Cutscene/Backgrounds/Living_Room_Night.png" fade="0.6"]
if {Calendar.IsDayOff()}:
	protagonist: Хм...
	protagonist: ...здесь никого нет.
	- Вернуться в комнату
		jump night/RETURN
Тебе удаётся застать свою соседку перед сном. #id:190
join roommate center
if {GameVariables.relationship} >= 20 && {GameVariables.suspicion} < 50:
	roommate: Эй! Чем я могу помочь? #id:197
else:
	roommate: Что это? #id:198
label MAIN #id:88f
- Подарить подарок #id:d14
	jump GIVE_GIFT
- Отдать предмет #id:890
	jump GIVE_ITEM
- Отдать аксессуар #id:891
	jump ACCESSORY
