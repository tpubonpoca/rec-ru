label START #id:f88
jump sounds/INDOOR_APARTMENT_ENVIRONMENT
[background arg="res://assets/Cutscene/Backgrounds/Kitchen.png" fade="0.6"]
if {GameVariables.is_recipe_served}:
	set GameVariables.is_recipe_served = false
	jump REACTION
if {Calendar.IsDayInKitchen()}:
	[wait time="1.0"]
	join roommate
	if {GameVariables.relationship} >= 40:
		update roommate [extra_data="set Expressions/Happy"]
		roommate: Доброе утро! #id:f89
	elif {GameVariables.relationship} >= 20:
		roommate: ...доброе утро. #id:f8a
	{roommate_name} сейчас тоже на кухне. #id:f8b
protagonist: Интересно, что мне приготовить... #id:f8c
label CHOICES #id:f8d
- Готовить в одиночку #id:f8e
	set GameVariables.yuna_partnered = false
	protagonist: Ладно, посмотрим, что я могу сообразить. #id:f8f
	jump z_functions/END_TO_KITCHEN
- Готовить на двоих | [if {Calendar.IsDayInKitchen()} == true] #id:f90
	set GameVariables.yuna_partnered = true
	protagonist: Эй, ты голодна? Могу приготовить что-нибудь для тебя... #id:f91
	roommate: Хмм... #id:1b0
	if {GameVariables.suspicion} >= 50:
		update roommate [extra_data="set Expressions/Confused"]
		[sound bus="Cutscene" path="res://audio/voice/ano3_Um.ogg"]
		roommate: Я уже поела... #id:f92
		roommate: ...извини. #id:f93
		protagonist: (Похоже, она [color=ff3f49]относится ко мне с подозрением[/color].) #id:1b2
		protagonist: (Ночью стоит быть осторожнее.) #id:1b3
		update roommate [extra_data="set Expressions/Default"]
		jump CHOICES
	else:
		roommate: ...конечно! Что вкусненького приготовишь? #id:f94
		jump z_functions/END_TO_KITCHEN
- Назад #id:f95
	leave roommate
	[background arg="res://assets/Cutscene/Backgrounds/Dorm_Room.png" fade="0.6"]
	jump morning/START
label REACTION #id:f96
jump sounds/DISHES
Ты закончил готовить блюдо. #id:f97
if {GameVariables.yuna_partnered} == true
	set GameVariables.scene_unlocked = {Cutscenes.UnlockCutscene("event_relationship_20")}
	join roommate [extra_data="set Expressions/Default"]
	{roommate_name} терпеливо сидит за кухонным столом. #id:f98
	update roommate [extra_data="set Expressions/Happy"]
	jump sounds/VOICE_LETS_EAT
	roommate: <Давай поедим!/Не могу дождаться, когда попробую!/Пахнет вкусно!> #id:f99
if {GameVariables.recipe_rating} == 0:
	protagonist: (В итоге я ничего не приготовил...) #id:f9a
else:
	Ты подал [color=e5be3e]{GameVariables.recipe_name}[/color]. #id:f9b
	jump sounds/DISHES
