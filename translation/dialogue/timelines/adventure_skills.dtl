			[sound bus="Cutscene" path="res://audio/se/Powerup_XP.wav" volume="0.0"]
			[color=ff3f49]{BattleVariables.enemies[2].GetName()}[/color] усиливается!
		if {BattleVariables.enemies[2].EmpowermentHeals} > 0:
