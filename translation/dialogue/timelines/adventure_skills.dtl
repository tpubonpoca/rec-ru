label START #id:14b
[signal arg="skill_activate"]
[signal arg="skill_prep_sound"]
[color=ff3f49]{BattleVariables.acting_enemy.GetName()}[/color]{BattleVariables.acting_enemy.LoadedSkill.Description}
if {BattleVariables.enemy_turn_index} == 0 && {BattleVariables.acting_enemy.LoadedSkill.PrepQuote} != "":
	enemy: {BattleVariables.acting_enemy.LoadedSkill.PrepQuote} #id:10a0
if {BattleVariables.enemy_turn_index} == 1 && {BattleVariables.acting_enemy.LoadedSkill.PrepQuote} != "":
	enemy_2: {BattleVariables.acting_enemy.LoadedSkill.PrepQuote} #id:10a1
if {BattleVariables.acting_enemy.LoadedSkill.IsPreparing()}:
	jump adventure_functions/END_ENEMY_TURN
if {BattleVariables.acting_enemy.LoadedSkill.ShouldDelay()}:
	if {BattleVariables.acting_enemy.LoadedSkill.IsCopycat()} && {BattleVariables.enemy_turn_index} == 0:
		enemy: [color=ff3f49]{tr(BattleVariables.acting_enemy.LoadedSkill.LoadCopycatSkill().Name)}[/color]: навык заряжен.
	if {BattleVariables.acting_enemy.LoadedSkill.IsCopycat()} && {BattleVariables.enemy_turn_index} == 1:
		enemy_2: [color=ff3f49]{tr(BattleVariables.acting_enemy.LoadedSkill.LoadCopycatSkill().Name)}[/color]: навык заряжен.
	jump adventure_functions/END_ENEMY_TURN
[signal arg="skill_use_sound"]
if {BattleVariables.acting_enemy.GetLoadedSkill().DelayBeforeEffect}:
	if {BattleVariables.acting_enemy.GetLoadedSkill().DelayLongerEffect}:
		[wait time="3.0"]
	else:
		[wait time="0.6"]
if {BattleVariables.acting_enemy.GetLoadedSkill().UsageGreenEffect}:
	[signal arg="vision_green"]
if {BattleVariables.acting_enemy.GetLoadedSkill().UsageRedEffect}:
	[signal arg="vision_red"]
if {BattleVariables.acting_enemy.GetLoadedSkill().UsageWhiteEffect}:
	[signal arg="screenshot"]
if {BattleVariables.acting_enemy.GetLoadedSkill().UsageShakeEffect}:
	[signal arg="shake"]
if {BattleVariables.acting_enemy.GetLoadedSkill().UsageShakeEffectIncludeSound}:
	[sound bus="Cutscene" volume="-3.0" path="res://audio/se/Hit1.ogg"]
[color=ff3f49]{BattleVariables.acting_enemy.GetName()}[/color] использует [color=ff3f49]{tr(BattleVariables.acting_enemy.GetLoadedSkill().Name)}[/color]!
if {BattleVariables.enemy_turn_index} == 0 && {BattleVariables.acting_enemy.GetLoadedSkill().UsageQuote} != "":
	enemy: {BattleVariables.acting_enemy.GetLoadedSkill().UsageQuote} #id:10a3
if {BattleVariables.enemy_turn_index} == 1 && {BattleVariables.acting_enemy.GetLoadedSkill().UsageQuote} != "":
	enemy_2: {BattleVariables.acting_enemy.GetLoadedSkill().UsageQuote} #id:10a4
if {BattleVariables.acting_enemy.GetLoadedSkill().PowerUpSound}:
	[sound bus="Cutscene" path="res://audio/se/Powerup_XP.wav" volume="0.0"]
if {BattleVariables.acting_enemy.GetLoadedSkill().PowerUpDescription} != "":
	[color=ff3f49]{BattleVariables.acting_enemy.GetName()}[/color]{BattleVariables.acting_enemy.GetLoadedSkill().PowerUpDescription}

if {BattleVariables.acting_enemy.GetLoadedSkill().DoesDamage}:
	jump adventure_functions/GUARD_MESSAGE
	Ты теряешь [color=ff3f49]{BattleVariables.take_damage(BattleVariables.acting_enemy.GetLoadedSkill().DamageMultiplier)}[/color] выносливости. #id:10a6

if {BattleVariables.acting_enemy.GetLoadedSkill().CreditPercentageStolen} > 0:
	jump sounds/BATTLE_STUN
	[signal arg="shake"]
	[color=ff3f49]{BattleVariables.acting_enemy.GetName()}[/color] украл(а) у тебя [color=e5be3e]{BattleVariables.steal_money()}[/color] кредитов!

if {BattleVariables.acting_enemy.GetLoadedSkill().GetEffectiveStun()} > 0:
	if {BattleVariables.player_is_defending}:
		Тебе удалось не попасть под оглушение! #id:10a8
	else:
		jump sounds/BATTLE_STUN
		[signal arg="shake"]
		Ты оглушён! #id:14f
		set BattleVariables.player_is_stunned = true
		set BattleVariables.player_is_stunned_duration += {BattleVariables.acting_enemy.GetLoadedSkill().GetEffectiveStun()}

if {BattleVariables.acting_enemy.GetLoadedSkill().StunPartner} > 0 && {GameVariables.yuna_partnered}:
	jump sounds/BATTLE_STUN
	[signal arg="shake"]
	update roommate [extra_data="set Expressions/Tired, show Decorations/Sweat"]
	Юна оглушена!
	set BattleVariables.yuna_is_stunned = true
	set BattleVariables.yuna_is_stunned_duration += {BattleVariables.acting_enemy.GetLoadedSkill().StunPartner}

if {BattleVariables.acting_enemy.GetLoadedSkill().PoisonTickDamage} > 0:
	jump sounds/BATTLE_POISON
	[signal arg="shake"]
	Тебя отравили! #id:153
	set BattleVariables.poison_tick_damage += {BattleVariables.acting_enemy.GetLoadedSkill().PoisonTickDamage}
	set BattleVariables.poison_turns += {BattleVariables.acting_enemy.GetLoadedSkill().PoisonDuration}

if {BattleVariables.acting_enemy.GetLoadedSkill().Healing} > 0:
	[signal arg="skill_healing"]
	[signal arg="heal_enemy"]
	[sound bus="Cutscene" path="res://audio/se/Powerup_XP.wav" volume="0.0"]
	if {BattleVariables.acting_enemy.GetLoadedSkill().HealsAll} && {BattleVariables.are_multiple_enemies_alive()}:
		[color=ff3f49]{BattleVariables.acting_enemy.GetName()}[/color] исцелил(а) себя и свою команду!
	else:
		[color=ff3f49]{BattleVariables.acting_enemy.GetName()}[/color] исцелил(а) себя!

if {BattleVariables.acting_enemy.GetLoadedSkill().Flee} == true:
	set BattleVariables.acting_enemy.RanAway = true
	if {BattleVariables.enemy_turn_index} == 0
		leave enemy
	if {BattleVariables.enemy_turn_index} == 1
		leave enemy_2
	if {BattleVariables.are_enemies_alive()} == false:
		jump adventure_functions/REWARDS

if {BattleVariables.acting_enemy.GetLoadedSkill().Confusion} > 0:
	if {BattleVariables.player_is_defending} == false:
		set BattleVariables.player_is_confused = true
		set BattleVariables.player_is_confused_duration = {BattleVariables.acting_enemy.GetLoadedSkill().Confusion}
		Ты в замешательстве!
	else:
		jump adventure_functions/GUARD_MESSAGE
		Тебе удалось не растеряться!

if {BattleVariables.acting_enemy.GetLoadedSkill().Jammed} > 0:
	[signal arg="jam_abilities"]
	set BattleVariables.player_is_jammed = true
	set BattleVariables.player_is_jammed_duration = {BattleVariables.acting_enemy.GetLoadedSkill().Jammed}
	Способность заблокирована: [color=e5be3e]{BattleVariables.get_jammed_ability()}[/color]!

if {BattleVariables.acting_enemy.GetLoadedSkill().Madness} == true:
	if {BattleVariables.player_is_defending} == false:
		set BattleVariables.player_is_mad = true
		Ты в бешенстве! #id:10ab
	else:
		jump adventure_functions/GUARD_MESSAGE
		Тебе удалось не сорваться! #id:10ac

if {BattleVariables.acting_enemy.GetLoadedSkill().SummonEnemies.size()} > 0:
	jump adventure_functions/SUMMON_ENEMY

jump adventure_functions/END_ENEMY_TURN

label PLAYER #id:164
- Paparazzi #id:165
	if {BattleVariables.player_is_confused}:
